# 复制为 .env 后填写实际连接信息与密钥；不要在此模板中保存真实凭证。
# 聊天模型默认值和 Milvus 连接在 config/ 下的 YAML 文件中配置。

# 必填：PostgreSQL 连接与 JWT 签名密钥
PG_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/shallow_ask_deep_answer
# 生成随机值：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 必填：当前 DashScope 配置的聊天模型、嵌入与精排服务密钥
# 同一个具有相应权限的 DashScope 密钥可同时填入下面两项。
OPENAI_API_KEY=
# 同时用于原生 embedding 和 rerank 接口。
DASHSCOPE_API_KEY=

# 可选：覆盖 config/agent.yaml 中的聊天模型配置；修改后重启后端。
# .env 覆盖同名环境变量；未定义的变量沿用已有环境，模型配置未设置或为空时回退到 YAML。
# 模型采用 provider:model 合并格式，由 init_chat_model 解析。
# 主代理配置同时用于知识库与通用问答模式，以及会话压缩。
# MAIN_AGENT_MODEL=openai:deepseek-v4.1-flash-1017
# MAIN_AGENT_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
# 知识库检索子代理配置。
# RAG_SUMMARY_MODEL=openai:deepseek-v4.1-flash-1017
# RAG_SUMMARY_MODEL_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# 可选：仅联网搜索需要
TAVILY_API_KEY=

# 以下均为可选参数，注释中的值与代码默认值一致；按需取消注释修改。
# 除明确标注外，时间单位均为秒。

# 服务与日志
# HOST=0.0.0.0
# PORT=8000
# UVICORN_WORKERS=1
# ENABLE_API_DOCS=false
# LOG_LEVEL=INFO
# THREADPOOL_SIZE=200

# 数据库连接池（每个 worker 分别持有业务池与检查点池）
# PG_POOL_MIN=2
# PG_POOL_MAX=20
# PG_CHECKPOINT_POOL_MIN=2
# PG_CHECKPOINT_POOL_MAX=20

# 认证、注册与登录限流
# JWT_EXPIRE_HOURS=72
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600
# LOGIN_ACCOUNT_RATE_LIMIT=10
# LOGIN_ACCOUNT_RATE_WINDOW_SECONDS=60
# LOGIN_IP_RATE_LIMIT=100
# LOGIN_IP_RATE_WINDOW_SECONDS=60
# LOGIN_ACCOUNT_IP_MAX_ATTEMPTS=5
# LOGIN_ACCOUNT_IP_WINDOW_SECONDS=900

# 对话限制、生成截止时间与存活检测
# CHAT_MESSAGE_MAX_CHARS=8000
# CHAT_RATE_LIMIT=30
# CHAT_RATE_WINDOW_SECONDS=60
# 同一用户同时生成的会话数，0 表示不限，正数设置上限
# MAX_CONCURRENT_CHAT_PER_USER=0
# CHAT_SLOT_MAX_AGE_SECONDS=1800
# CHAT_STREAM_DEADLINE_SECONDS=300
# CHAT_GENERATION_SAVE_SECONDS=0.5
# CHAT_GENERATION_STALE_SECONDS=120

# 上传、索引与健康检查
# 用户上传源文件必须放在源码项目之外；默认使用仓库同级 shallow-ask-deep-answer-data
# 指定时请使用绝对路径，例如 D:/KnowledgeData/shallow-ask-deep-answer
# KNOWLEDGE_STORAGE_ROOT=D:/KnowledgeData/shallow-ask-deep-answer
# MAX_UPLOAD_MB=50
# 每个 API worker 的后台索引线程数；同一项目仍串行，不同项目可并行。
# 总后台并发上限约为 UVICORN_WORKERS × UPLOAD_WORKERS。
# UPLOAD_WORKERS=4
# 空闲队列轮询间隔（秒）
# UPLOAD_TASK_POLL_SECONDS=0.5
# HEALTH_REPORT_TTL_SECONDS=120
# 只读检查总时限（含排队、进程启动、扫描和结果传输）及每个 API worker 的扫描并发上限
# HEALTH_CHECK_TIMEOUT_SECONDS=60
# HEALTH_CHECK_MAX_CONCURRENT=2
# INDEX_WRITE_LOCK_TIMEOUT_SECONDS=300
# INDEX_READ_LOCK_TIMEOUT_SECONDS=30
# 就绪检查总时限（含进程启动、PostgreSQL 建连/查询及 Milvus RPC）
# READINESS_TIMEOUT_SECONDS=3

# 前端只读请求超时（毫秒）；写入 frontend-chat/.env.local 或前端构建环境，根目录 .env 不生效
# 建议略大于 HEALTH_CHECK_TIMEOUT_SECONDS，修改后重新启动/构建前端
# VITE_KNOWLEDGE_REQUEST_TIMEOUT_MS=65000

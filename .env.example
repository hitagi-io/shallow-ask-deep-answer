# 复制为 .env 后填写实际连接信息与密钥；不要在此模板中保存真实凭证。
# 模型名称、接口地址和 Milvus 连接在 config/ 下的 YAML 文件中配置。

# 必填：PostgreSQL 连接与 JWT 签名密钥
PG_CONNECTION_STRING=postgresql://postgres:password@localhost:5432/deepagent_rag
# 生成随机值：python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=

# 必填：当前 DashScope 配置的聊天模型与嵌入服务密钥
# 同一个具有相应权限的 DashScope 密钥可同时填入下面两项。
OPENAI_API_KEY=
DASHSCOPE_API_KEY=

# 可选：仅联网搜索需要
TAVILY_API_KEY=

# 以下均为可选参数，注释中的值与代码默认值一致；按需取消注释修改。
# 除明确标注外，时间单位均为秒。

# 服务与日志
# HOST=0.0.0.0
# PORT=8000
# UVICORN_WORKERS=1
# ENABLE_API_DOCS=false
# LOG_LEVEL=INFO
# THREADPOOL_SIZE=200

# 数据库连接池（每个 worker 分别持有业务池与检查点池）
# PG_POOL_MIN=2
# PG_POOL_MAX=20
# PG_CHECKPOINT_POOL_MIN=2
# PG_CHECKPOINT_POOL_MAX=20

# 认证、注册与登录限流
# JWT_EXPIRE_HOURS=72
# USER_CACHE_TTL_SECONDS=30
# REGISTER_RATE_LIMIT=5
# REGISTER_RATE_WINDOW_SECONDS=3600
# LOGIN_ACCOUNT_RATE_LIMIT=10
# LOGIN_ACCOUNT_RATE_WINDOW_SECONDS=60
# LOGIN_IP_RATE_LIMIT=100
# LOGIN_IP_RATE_WINDOW_SECONDS=60
# LOGIN_ACCOUNT_IP_MAX_ATTEMPTS=5
# LOGIN_ACCOUNT_IP_WINDOW_SECONDS=900

# 对话限制、生成截止时间与存活检测
# CHAT_MESSAGE_MAX_CHARS=8000
# CHAT_RATE_LIMIT=30
# CHAT_RATE_WINDOW_SECONDS=60
# MAX_CONCURRENT_CHAT_PER_USER=3
# CHAT_SLOT_MAX_AGE_SECONDS=1800
# CHAT_STREAM_DEADLINE_SECONDS=300
# CHAT_GENERATION_HEARTBEAT_SECONDS=10
# CHAT_GENERATION_STALE_SECONDS=120

# 上传、索引与健康检查
# MAX_UPLOAD_MB=50
# HEALTH_REPORT_TTL_SECONDS=120
# INDEX_WRITE_LOCK_TIMEOUT_SECONDS=300
# INDEX_READ_LOCK_TIMEOUT_SECONDS=30
# READINESS_TIMEOUT_SECONDS=3
